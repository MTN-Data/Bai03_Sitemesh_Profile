<?xml version="1.0" encoding="UTF-8"?>

<sitemesh>

    <decorator-prefix>
        /WEB-INF/decorators/
    </decorator-prefix>

    <mapping
        path="/home"
        decorator="main.jsp"/>

    <mapping
        path="/profile"
        decorator="main.jsp"/>

    <mapping
        path="/product"
        decorator="main.jsp"/>

    <mapping
        path="/product/*"
        decorator="main.jsp"/>

    <mapping
        path="/css/*"
        exclude="true"/>

    <mapping
        path="/images/*"
        exclude="true"/>

    <mapping
        path="/uploads/*"
        exclude="true"/>

    <mapping
        path="/image"
        exclude="true"/>

</sitemesh>